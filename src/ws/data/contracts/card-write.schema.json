    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "epic": {
      "type": "string"
    },
    "parent": {
      "type": "string"
    },
    "assignee": {
      "type": "string"
    },
